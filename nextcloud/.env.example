NEXTCLOUD_APP_IMAGE=nextcloud:29.0.8-apache
NEXTCLOUD_DB_IMAGE=mariadb:11.4.4
NEXTCLOUD_REDIS_IMAGE=redis:7.4.2-alpine

MARIADB_ROOT_PASSWORD=replace-with-strong-root-password
MARIADB_PASSWORD=replace-with-strong-nextcloud-password
MYSQL_PASSWORD=replace-with-strong-nextcloud-password
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-strong-admin-password
NEXTCLOUD_TRUSTED_DOMAINS=nc.ivantili.site
PHP_MEMORY_LIMIT=1024M
UPLOAD_LIMIT=16G
