{
  email {$ACME_EMAIL}
  admin off
}

(secure_headers) {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  }
}

nc.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy nextcloud:80
}

immich.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy immich-server:2283
}

hometheater.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy jellyfin:8096
}

jellyseerr.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy jellyseerr:5055
}

calibre.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy calibre-web:8083
}

navidrome.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy navidrome:4533
}

audiobookshelf.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy audiobookshelf:80
}

# Optional Home Assistant through Caddy while Home Assistant runs in host network mode.
ha.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy host.docker.internal:8123
}

transmission.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy transmission:9091
}

invidious.{$ROOT_DOMAIN} {                                                                      
  import secure_headers                                                                         
  @blocked not remote_ip 192.168.1.0/24                                                         
  respond @blocked 403                                                                          
  reverse_proxy invidious:3000                                                                  
}

n8n.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy n8n:5678
}

auth.{$ROOT_DOMAIN} {
  import secure_headers
  reverse_proxy authelia:9091
}
