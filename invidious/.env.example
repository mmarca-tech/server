INVIDIOUS_IMAGE=quay.io/invidious/invidious:latest
INV_SIG_HELPER_IMAGE=quay.io/invidious/inv_sig_helper:latest
INVIDIOUS_DB_IMAGE=docker.io/library/postgres:16-alpine

# Your Invidious public domain (must match Caddy and DNS)
INVIDIOUS_DOMAIN=invidious.example.com

# Strong random password — generate with: openssl rand -hex 32
INVIDIOUS_DB_PASSWORD=changeme
