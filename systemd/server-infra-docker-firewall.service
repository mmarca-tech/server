[Unit]
Description=Server infrastructure Docker ingress policy
After=docker.service ufw.service
Requires=docker.service

[Service]
Type=oneshot
Environment=GITEA_SSH_PORT=__GITEA_SSH_PORT__
ExecStart=/usr/local/sbin/server-infra-docker-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

