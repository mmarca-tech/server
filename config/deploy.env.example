# Copy to /root/server.env and chmod 600. Values are shell syntax.
# The deployment never writes secrets back to this repository.

ROOT_DOMAIN=example.com
ACME_EMAIL=admin@example.com
TZ=Europe/Tallinn

ADMIN_USER=serveradmin
ADMIN_EMAIL=admin@example.com
SSH_PORT=22
SSH_PUBLIC_KEY='ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY'

# Public addresses assigned by AlphaVPS. Leave PUBLIC_IPV6 empty if unused and
# ensure no AAAA records exist for the public hostnames.
PUBLIC_IPV4=203.0.113.10
PUBLIC_IPV6=

# Full deploys every supported service. Core omits the media automation/VPN,
# Tdarr, AdGuard, and MollySocket stacks.
DEPLOY_PROFILE=full
ALLOW_LOW_RESOURCES=false
DEDICATED_CPU_ACK=false
LAWFUL_MEDIA_ACK=false

# Private administration network generated by deploy.sh.
WG_ADDRESS=10.66.0.1/24
WG_CLIENT_ADDRESS=10.66.0.2/32
WG_PORT=51820
WG_CLIENT_NAME=admin
ADGUARD_ADMIN_PORT=3001

# Private ProtonVPN WireGuard credentials used only by Gluetun. Rotate the old
# repository credential before deployment.
PROTON_WIREGUARD_PRIVATE_KEY=REPLACE_ME
PROTON_WIREGUARD_ADDRESSES=10.2.0.2/32
PROTON_SERVER_COUNTRIES=Estonia

# Generate with the pinned Authelia image, or another trusted Authelia install:
# authelia crypto hash generate argon2 --password 'a-long-password'
AUTHELIA_ADMIN_PASSWORD_HASH='REPLACE_ME'

# Woodpecker CI agent that attaches to the Codeberg-hosted instance. Get the
# agent secret from https://ci.codeberg.org (user/org settings, "Agents").
# Override WOODPECKER_SERVER only for a self-hosted Woodpecker server.
WOODPECKER_AGENT_SECRET=REPLACE_ME
WOODPECKER_SERVER=ci.codeberg.org:443
WOODPECKER_MAX_WORKFLOWS=2

# Self-hosted Gitea with Gitea Actions. Served publicly by Caddy on its own
# domain (create an A record GITEA_DOMAIN -> PUBLIC_IPV4). The admin account and
# the Actions runner token are generated automatically on first deploy. Git
# over SSH is published on GITEA_SSH_PORT (clone as ssh://git@GITEA_DOMAIN:PORT).
GITEA_DOMAIN=git.example.com
GITEA_SSH_PORT=2222

# Normally false. These are explicit escape hatches for offline validation.
SKIP_DNS_CHECK=false
ALLOW_UNSUPPORTED_OS=false
