# Configure Mollysocket variables based on the image documentation you use.
# Keep this file free of secrets in git. Copy to .env and fill required keys.
MOLLYSOCKET_IMAGE=ghcr.io/mollyim/mollysocket:v1.3.0
#
# Example placeholders (replace/remove as needed):
# MOLLY_SOCKET_BIND=0.0.0.0:8020
# MOLLY_DATABASE_PATH=/data/mollysocket.db
# MOLLY_ALLOWED_ENDPOINTS=https://your.signal.server
