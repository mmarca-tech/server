# MollySocket runtime settings
# Copy to .env and fill required keys. Keep secrets out of git.
MOLLYSOCKET_IMAGE=ghcr.io/mollyim/mollysocket:latest
MOLLY_HOST=0.0.0.0
MOLLY_PORT=8020
MOLLY_DB=/data/ms.sqlite
MOLLY_WEBSERVER=true
RUST_LOG=info

# Required for push delivery:
# generate with:
#   docker compose --profile tools run --rm mollysocket-cli vapid gen
MOLLY_VAPID_PRIVKEY=replace-with-generated-vapid-private-key

# Access control hardening (defaults keep compatibility):
MOLLY_ALLOWED_ENDPOINTS=["*"]
MOLLY_ALLOWED_UUIDS=["*"]

# Air-gapped Android onboarding mode (manual registration):
# 1) set MOLLY_WEBSERVER=false
# 2) run commands with:
#    docker compose --profile tools run --rm mollysocket-cli <mollysocket-command>
# Example:
#    docker compose --profile tools run --rm mollysocket-cli connection ping <account-uuid>
