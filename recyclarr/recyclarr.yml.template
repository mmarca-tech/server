# Recyclarr Configuration
# Copy to /srv/recyclarr/config/recyclarr.yml and fill in API keys
# Get API keys from: Sonarr/Radarr → Settings → General → API Key
#
# Uses TRaSH Guides built-in templates (auto-updated by Recyclarr)
# List available templates: docker exec recyclarr recyclarr config list templates
# Docs: https://recyclarr.dev/wiki/guide-configs/

sonarr:
  tv-shows:
    base_url: http://sonarr:8989
    api_key: YOUR_SONARR_API_KEY

    include:
      - template: web-1080p

radarr:
  movies:
    base_url: http://radarr:7878
    api_key: YOUR_RADARR_API_KEY

    include:
      - template: hd-bluray-web
