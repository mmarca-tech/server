# Recyclarr Configuration
# Copy to /srv/recyclarr/config/recyclarr.yml and fill in API keys
# Get API keys from: Sonarr/Radarr → Settings → General → API Key
#
# TRaSH Guides: https://trash-guides.info/
# Recyclarr wiki: https://recyclarr.dev/wiki/

# Auto-sync schedule (cron format) - daily at 3am
sonarr:
  tv-shows:
    base_url: http://sonarr:8989
    api_key: YOUR_SONARR_API_KEY

    # TRaSH recommended quality profiles for TV
    quality_definition:
      type: series

    quality_profiles:
      - name: WEB-1080p
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: WEB 1080p
          until_score: 10000
        min_format_score: 0
        quality_sort: top

    custom_formats:
      # Unwanted
      - trash_ids:
          - 85c61753df5da1fb2aab6f2a47426b09  # BR-DISK
          - 9c11cd3f07101cdba90a2d81cf0e56b4  # LQ
          - e2315f990da2e2cbfc9fa5b7a6fcfe48  # LQ (Release Title)
          - 47435ece6b99a0b477caf360e79ba0bb  # x265 (HD)
        assign_scores_to:
          - name: WEB-1080p

      # Streaming Services (prefer)
      - trash_ids:
          - d660701077794679fd59e8bdf4ce3a29  # AMZN
          - f67c9ca88f463a48346062e8ad07713f  # ATVP
          - 36b72f59f4ea20aad9316f475f2d9fbb  # DCU
          - 89358767a60cc28783ab36d917f30c2e  # DSNP
          - 7a235133c87f7da4c8571f0b3d3e2c68  # HBO
          - a880d6abc21e7c16884f3ae393f84179  # HMAX
          - f6cce30f1733d5c8194222a7507f2571  # HULU
          - 0ac24a2a68a9700bcb7ece4c as well  # iT
          - 81d1fbf600e2540cee87f3a23f9d3c1c  # MAX
          - d34870697c9db575f17700212167be23  # NF
          - 1656adc6d7bb2c8cca6acfb6592db421  # PCOK
          - c67a75ae4a1715f2bb4d492c17f80d64  # PMTP
          - ae58039e1319178e6be73f5f551b1571  # SHO
        assign_scores_to:
          - name: WEB-1080p

radarr:
  movies:
    base_url: http://radarr:7878
    api_key: YOUR_RADARR_API_KEY

    # TRaSH recommended quality profiles for Movies
    quality_definition:
      type: movie

    quality_profiles:
      - name: HD Bluray + WEB
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: Bluray-1080p
          until_score: 10000
        min_format_score: 0
        quality_sort: top

