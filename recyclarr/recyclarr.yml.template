# Recyclarr Configuration
# Copy to /srv/recyclarr/config/recyclarr.yml and fill in API keys
# Get API keys from: Sonarr/Radarr → Settings → General → API Key
#
# Uses TRaSH Guides built-in templates (auto-updated by Recyclarr)
# Docs: https://recyclarr.dev/wiki/guide-configs/

sonarr:
  tv-shows:
    base_url: http://sonarr:8989
    api_key: YOUR_SONARR_API_KEY

    include:
      # WEB-1080p quality profile from TRaSH Guides
      - template: sonarr-quality-definition-series
      - template: sonarr-v4-quality-profile-web-1080p
      - template: sonarr-v4-custom-formats-web-1080p

radarr:
  movies:
    base_url: http://radarr:7878
    api_key: YOUR_RADARR_API_KEY

    include:
      # HD Bluray + WEB quality profile from TRaSH Guides
      - template: radarr-quality-definition-movie
      - template: radarr-quality-profile-hd-bluray-web
      - template: radarr-custom-formats-hd-bluray-web
