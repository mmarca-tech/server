# /etc/openclaw/openclaw.env
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# OpenAI cloud (recommended default):
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=openai/gpt-5.2
OPENAI_BASE_URL=

# Mistral cloud can also use the OPENAI_* keys with:
# OPENAI_API_KEY=replace-with-mistral-api-key
# OPENAI_MODEL=openai/mistral-medium-latest
# OPENAI_BASE_URL=https://api.mistral.ai/v1

# Other providers (optional):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional local Ollama mode:
OLLAMA_API_KEY=
