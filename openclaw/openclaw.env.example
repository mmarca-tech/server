# /etc/openclaw/openclaw.env
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Cloud providers (optional when using local model runtime):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=ollama-local

# Optional OpenAI-compatible endpoint settings (leave empty for native Ollama mode):
OPENAI_BASE_URL=
OPENAI_MODEL=
