# /etc/openclaw/openclaw.env
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Cloud providers (optional when using local model runtime):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local OpenAI-compatible endpoint (for example Ollama):
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=openai/gpt-4o-mini
