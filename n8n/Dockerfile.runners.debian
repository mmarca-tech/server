ARG N8N_RUNNERS_IMAGE
FROM ${N8N_RUNNERS_IMAGE}

USER root
WORKDIR /opt/runners/task-runner-python
COPY runner-requirements.txt /tmp/runner-requirements.txt
RUN uv pip install --requirement /tmp/runner-requirements.txt

COPY n8n-task-runners.json /etc/n8n-task-runners.json
RUN chown runner:runner /etc/n8n-task-runners.json

USER runner
WORKDIR /home/runner
